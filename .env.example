APP_NAME="Taller Integrador"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mazatlan
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret


# # --- MongoDB ---
# MONGO_HOST=mongodb
# MONGO_PORT=27017
# MONGO_DATABASE=laravel
# MONGO_USERNAME=laravel
# MONGO_PASSWORD=secret
# MONGO_ROOT_USERNAME=root
# MONGO_ROOT_PASSWORD=rootsecret

# --- Cache / Sesiones / Colas (Redis) ---
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# # --- Correo (Mailpit en desarrollo) ---
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="no-reply@taller.local"
# MAIL_FROM_NAME="${APP_NAME}"

# --- Vite ---
VITE_PORT=5173

# --- Puertos expuestos por docker-compose (host) ---
APP_PORT=8000
DB_FORWARD_PORT=5432
# MAILPIT_UI_PORT=8025
# MONGO_FORWARD_PORT=27017

# NUNCA subas el archivo .env real al repositorio.
# Cada integrante del equipo debe copiar este archivo como .env
# y ajustar sus propios valores.
